{
  "name": "dedicated-locale-tab",
  "version": "1.1.0",
  "private": true,
  "description": "Browser localization and timezone-isolation testing for web i18n, language compatibility, and privacy research.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huangzh317272-blip/dedicated-locale-tab.git"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "locale",
    "timezone",
    "localization-testing"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "node --test e2e/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "package": "node scripts/package-release.mjs",
    "store:screenshot": "node scripts/capture-store-screenshot.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
