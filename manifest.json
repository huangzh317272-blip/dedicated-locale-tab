{
  "manifest_version": 3,
  "name": "专用语言与时区页面",
  "description": "浏览器本地化与时区隔离测试插件，用于网页国际化开发、语言兼容性测试和隐私研究；不得用于绕过网站地区限制、账号封禁或安全措施。",
  "version": "1.1.0",
  "author": "huangzh317272-blip",
  "homepage_url": "https://github.com/huangzh317272-blip/dedicated-locale-tab",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开专用语言与时区页面",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
